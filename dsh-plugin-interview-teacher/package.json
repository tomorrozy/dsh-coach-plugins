{
  "name": "dsh-interview-teacher",
  "version": "0.1.0",
  "description": "Taurus 2027 电控组三面 · 面试老师：DSH 左侧栏全局面板，展示 81 个考核点进度、当前题号与面试命令，数据来自 interview_state.md 与考核点清单。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "*": {
      "optional": true
    }
  },
  "license": "MIT"
}
